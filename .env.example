# Supabase (frontend)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Socket.IO / signaling server URL
# Development: leave empty (Vite proxies /socket.io → localhost:3001)
# Production (Netlify): set to your deployed backend URL, e.g. https://signaling-server.example.com
VITE_SOCKET_URL=

# Supabase (server-side only — NEVER expose to frontend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server port for Socket.IO signaling
PORT=3001

# Resend — email service for notifications (https://resend.com)
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# ── VAPID Web Push ───────────────────────────────────────────────────────────
# Generate a keypair: npx web-push generate-vapid-keys --json
# VITE_VAPID_PUBLIC_KEY is exposed to the client (URL-safe base64).
# VAPID_PRIVATE_KEY is server-only; never bundle it.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@your-domain.com
